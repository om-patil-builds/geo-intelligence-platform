PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/geo-intelligence
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_MAX_RESULTS=40
GOOGLE_TEXT_SEARCH_MAX_PAGES=3
API_RATE_LIMIT=100


# Google Cloud Console OAuth Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/email/oauth/google/callback

# Server
SERVER_URL=http://localhost:5000

# AES-256 encryption secret for OAuth refresh tokens
ENCRYPTION_SECRET=your_32_byte_or_longer_secure_encryption_key